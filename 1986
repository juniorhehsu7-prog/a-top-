<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="UTF-8">
<meta name="viewport"
      content="width=device-width, initial-scale=1.0">

<title>Frequência Experimental</title>

<style>
    * {
        box-sizing: border-box;
    }

    body {
        margin: 0;
        background: #101010;
        color: #eeeeee;
        font-family: Arial, sans-serif;
    }

    header {
        padding: 20px;
        text-align: center;
        background: #181818;
        border-bottom: 1px solid #333;
    }

    h1 {
        margin: 0;
        font-size: 24px;
    }

    .subtitulo {
        margin-top: 8px;
        color: #999;
        font-size: 13px;
    }

    main {
        padding: 15px;
        max-width: 900px;
        margin: auto;
    }

    .painel {
        background: #181818;
        border: 1px solid #333;
        border-radius: 12px;
        padding: 15px;
        margin-bottom: 15px;
    }

    .titulo {
        font-size: 16px;
        font-weight: bold;
        margin-bottom: 12px;
    }

    .status {
        display: flex;
        justify-content: space-between;
        padding: 10px 0;
        border-bottom: 1px solid #292929;
    }

    .valor {
        font-weight: bold;
    }

    .frequencia {
        text-align: center;
        font-size: 38px;
        font-weight: bold;
        padding: 20px;
    }

    canvas {
        width: 100%;
        height: 220px;
        background: #080808;
        border-radius: 8px;
    }

    button {
        width: 100%;
        padding: 15px;
        margin-top: 8px;
        border: 0;
        border-radius: 8px;
        background: #303030;
        color: white;
        font-size: 16px;
    }

    button:active {
        transform: scale(0.98);
    }

    #legenda {
        min-height: 100px;
        background: #080808;
        border-radius: 8px;
        padding: 15px;
        font-size: 18px;
        line-height: 1.5;
    }

    #log {
        height: 150px;
        overflow-y: auto;
        background: #080808;
        border-radius: 8px;
        padding: 10px;
        font-family: monospace;
        font-size: 12px;
    }

    .aviso {
        color: #aaa;
        font-size: 12px;
        line-height: 1.5;
    }
</style>
</head>

<body>

<header>

    <h1> Frequência Experimental</h1>

    <div class="subtitulo">
        Análise experimental de sinais e padrões
    </div>

</header>

<main>

    <!-- STATUS -->

    <section class="painel">

        <div class="titulo">
            STATUS DO DISPOSITIVO
        </div>

        <div class="status">
            <span>Bluetooth</span>
            <span id="bluetooth"
                  class="valor">
                Verificando...
            </span>
        </div>

        <div class="status">
            <span>Microfone</span>
            <span id="microfone"
                  class="valor">
                Não iniciado
            </span>
        </div>

    </section>


    <!-- FREQUÊNCIA -->

    <section class="painel">

        <div class="titulo">
            FAIXA EXPERIMENTAL
        </div>

        <div class="frequencia">
            2,4 GHz
        </div>

        <div class="aviso">
            2,4 GHz é a faixa utilizada por tecnologias
            como Bluetooth e Wi-Fi. O navegador não
            mede diretamente o sinal RF bruto do celular.
        </div>

    </section>


    <!-- GRÁFICO -->

    <section class="painel">

        <div class="titulo">
            ANÁLISE DO SINAL
        </div>

        <canvas id="grafico"
                width="800"
                height="220">
        </canvas>

    </section>


    <!-- CONTROLE -->

    <section class="painel">

        <div class="titulo">
            EXPERIMENTO
        </div>

        <button onclick="iniciar()">
             INICIAR EXPERIMENTO
        </button>

        <button onclick="parar()">
             PARAR EXPERIMENTO
        </button>

        <button onclick="microfone()">
             ATIVAR MICROFONE
        </button>

        <button onclick="limpar()">
             LIMPAR REGISTRO
        </button>

    </section>


    <!-- LEGENDA -->

    <section class="painel">

        <div class="titulo">
            LEGENDA EXPERIMENTAL
        </div>

        <div id="legenda">
            Aguardando experimento...
        </div>

        <p class="aviso">
            A legenda é uma interpretação experimental
            produzida pelo algoritmo. Ela não constitui
            evidência de comunicação sobrenatural.
        </p>

    </section>


    <!-- LOG -->

    <section class="painel">

        <div class="titulo">
            REGISTRO
        </div>

        <div id="log"></div>

    </section>

</main>


<script>

let executando = false;

let timer = null;

let audioContext = null;

let analyser = null;

let dados = null;

const canvas =
    document.getElementById("grafico");

const ctx =
    canvas.getContext("2d");


/* =========================
   BLUETOOTH
========================= */

async function verificarBluetooth() {

    const elemento =
        document.getElementById("bluetooth");

    if ("bluetooth" in navigator) {

        elemento.textContent =
            "Disponível";

    } else {

        elemento.textContent =
            "API não disponível";

    }
}

verificarBluetooth();


/* =========================
   LOG
========================= */

function registrar(texto) {

    const log =
        document.getElementById("log");

    const agora =
        new Date().toLocaleTimeString();

    log.innerHTML +=
        "[" + agora + "] " +
        texto + "<br>";

    log.scrollTop =
        log.scrollHeight;
}


/* =========================
   INICIAR
========================= */

function iniciar() {

    if (executando)
        return;

    executando = true;

    registrar(
        "Experimento iniciado."
    );

    document.getElementById("legenda")
        .textContent =
        "Analisando padrões...";

    timer =
        setInterval(analisar, 100);
}


/* =========================
   PARAR
========================= */

function parar() {

    executando = false;

    clearInterval(timer);

    registrar(
        "Experimento encerrado."
    );

    document.getElementById("legenda")
        .textContent =
        "Experimento parado.";
}


/* =========================
   GERADOR DE DADOS
   PARA TESTE VISUAL
========================= */

function analisar() {

    if (!executando)
        return;

    let valor =
        Math.random() * 100;

    desenhar(valor);

    /*
       Estes dados são apenas
       simulados para testar
       o funcionamento da interface.
    */

    if (valor > 97) {

        detectarPadrao(valor);
    }
}


/* =========================
   GRÁFICO
========================= */

let pontos = [];

function desenhar(valor) {

    pontos.push(valor);

    if (pontos.length > 100) {

        pontos.shift();
    }

    ctx.clearRect(
        0,
        0,
        canvas.width,
        canvas.height
    );

    ctx.beginPath();

    for (
        let i = 0;
        i < pontos.length;
        i++
    ) {

        const x =
            i *
            (canvas.width / 100);

        const y =
            canvas.height -
            (pontos[i] / 100) *
            canvas.height;

        if (i === 0)
            ctx.moveTo(x, y);
        else
            ctx.lineTo(x, y);
    }

    ctx.strokeStyle = "#00ff88";

    ctx.lineWidth = 2;

    ctx.stroke();
}


/* =========================
   PADRÃO
========================= */

function detectarPadrao(valor) {

    registrar(
        "Padrão de intensidade detectado: " +
        valor.toFixed(1)
    );

    document.getElementById("legenda")
        .textContent =
        "Padrão detectado — aguardando análise...";
}


/* =========================
   MICROFONE
========================= */

async function microfone() {

    try {

        const stream =
            await navigator.mediaDevices
            .getUserMedia({
                audio: true
            });

        audioContext =
            new AudioContext();

        analyser =
            audioContext
            .createAnalyser();

        analyser.fftSize = 2048;

        const fonte =
            audioContext
            .createMediaStreamSource(stream);

        fonte.connect(analyser);

        dados =
            new Uint8Array(
                analyser.frequencyBinCount
            );

        document.getElementById("microfone")
            .textContent =
            "ATIVO";

        registrar(
            "Microfone ativado."
        );

        analisarAudio();

    } catch (erro) {

        document.getElementById("microfone")
            .textContent =
            "Acesso negado";

        registrar(
            "Não foi possível acessar o microfone."
        );
    }
}


/* =========================
   ANÁLISE DE ÁUDIO
========================= */

function analisarAudio() {

    if (!analyser)
        return;

    analyser.getByteFrequencyData(dados);

    let maior = 0;

    for (
        let i = 0;
        i < dados.length;
        i++
    ) {

        if (dados[i] > maior)
            maior = dados[i];
    }

    if (maior > 220) {

        registrar(
            "Pico de áudio detectado: " +
            maior
        );
    }

    requestAnimationFrame(
        analisarAudio
    );
}


/* =========================
   LIMPAR
========================= */

function limpar() {

    document.getElementById("log")
        .innerHTML = "";

    document.getElementById("legenda")
        .textContent =
        "Aguardando experimento...";

    pontos = [];

    ctx.clearRect(
        0,
        0,
        canvas.width,
        canvas.height
    );
}

</script>

</body>
</html>
